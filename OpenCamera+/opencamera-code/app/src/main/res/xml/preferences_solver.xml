<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >

    <PreferenceCategory
        android:key="preference_category_solver"
        android:title="@string/preference_category_solver">

        <ListPreference
            android:key="preference_solver_field_units"
            android:title="@string/preference_solver_field_units"
            android:summary="%s"
            android:entries="@array/preference_solver_field_units_entries"
            android:entryValues="@array/preference_solver_field_units_values"
            android:defaultValue="arcminwidth" />

        <EditTextPreference
            android:key="preference_solver_field_min"
            android:title="@string/preference_solver_field_min"
            android:summary="@string/preference_solver_field_min_summary"
            android:defaultValue="30"
            android:inputType="numberDecimal" />

        <EditTextPreference
            android:key="preference_solver_field_max"
            android:title="@string/preference_solver_field_max"
            android:summary="@string/preference_solver_field_max_summary"
            android:defaultValue="180"
            android:inputType="numberDecimal" />

        <EditTextPreference
            android:key="preference_solver_cpu_limit"
            android:title="@string/preference_solver_cpu_limit"
            android:summary="@string/preference_solver_cpu_limit_summary"
            android:defaultValue="60"
            android:inputType="number" />

        <EditTextPreference
            android:key="preference_solver_wall_timeout"
            android:title="@string/preference_solver_wall_timeout"
            android:summary="@string/preference_solver_wall_timeout_summary"
            android:defaultValue="120"
            android:inputType="number" />

        <EditTextPreference
            android:key="preference_solver_max_objects"
            android:title="@string/preference_solver_max_objects"
            android:summary="@string/preference_solver_max_objects_summary"
            android:defaultValue="100"
            android:inputType="number" />

        <ListPreference
            android:key="preference_solver_downsample"
            android:title="@string/preference_solver_downsample"
            android:summary="%s"
            android:entries="@array/preference_solver_downsample_entries"
            android:entryValues="@array/preference_solver_downsample_values"
            android:defaultValue="2" />

        <ListPreference
            android:key="preference_solver_parity"
            android:title="@string/preference_solver_parity"
            android:summary="%s"
            android:entries="@array/preference_solver_parity_entries"
            android:entryValues="@array/preference_solver_parity_values"
            android:defaultValue="both" />

        <SwitchPreference
            android:key="preference_solver_hint_enabled"
            android:title="@string/preference_solver_hint_enabled"
            android:summary="@string/preference_solver_hint_enabled_summary"
            android:defaultValue="false" />

        <EditTextPreference
            android:key="preference_solver_hint_radius"
            android:title="@string/preference_solver_hint_radius"
            android:summary="@string/preference_solver_hint_radius_summary"
            android:defaultValue="15"
            android:inputType="numberDecimal"
            android:dependency="preference_solver_hint_enabled" />

        <SwitchPreference
            android:key="preference_calibration_location_enabled"
            android:title="@string/preference_calibration_location_enabled"
            android:summary="@string/preference_calibration_location_enabled_summary"
            android:defaultValue="true" />

        <SwitchPreference
            android:key="preference_local_calibration_capture"
            android:title="@string/preference_local_calibration_capture"
            android:summary="@string/preference_local_calibration_capture_summary"
            android:defaultValue="false" />

        <SwitchPreference
            android:key="preference_global_calibration_apply"
            android:title="@string/preference_global_calibration_apply"
            android:summary="@string/preference_global_calibration_apply_summary"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="preference_category_calibration_quality"
        android:title="@string/preference_category_calibration_quality">

        <SwitchPreference
            android:key="preference_calibration_auto_decline_enabled"
            android:title="@string/preference_calibration_auto_decline_enabled"
            android:summary="@string/preference_calibration_auto_decline_enabled_summary"
            android:defaultValue="false" />

        <EditTextPreference
            android:key="preference_calibration_max_zenith_offset"
            android:title="@string/preference_calibration_max_zenith_offset"
            android:summary="@string/preference_calibration_max_zenith_offset_summary"
            android:defaultValue="30"
            android:inputType="numberDecimal"
            android:dependency="preference_calibration_auto_decline_enabled" />

        <EditTextPreference
            android:key="preference_calibration_max_location_error"
            android:title="@string/preference_calibration_max_location_error"
            android:summary="@string/preference_calibration_max_location_error_summary"
            android:defaultValue="5"
            android:inputType="numberDecimal"
            android:dependency="preference_calibration_auto_decline_enabled" />

        <EditTextPreference
            android:key="preference_calibration_min_quality_score"
            android:title="@string/preference_calibration_min_quality_score"
            android:summary="@string/preference_calibration_min_quality_score_summary"
            android:defaultValue="60"
            android:inputType="number"
            android:dependency="preference_calibration_auto_decline_enabled" />

        <EditTextPreference
            android:key="preference_calibration_degree_step"
            android:title="@string/preference_calibration_degree_step"
            android:summary="@string/preference_calibration_degree_step_summary"
            android:defaultValue="5.0"
            android:inputType="numberDecimal" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="preference_category_iers_data"
        android:title="@string/preference_category_iers_data">

        <Preference
            android:key="preference_iers_sync_button"
            android:title="@string/preference_iers_sync_button"
            android:summary="@string/preference_iers_sync_button_summary" />

        <Preference
            android:key="preference_iers_last_sync"
            android:title="@string/preference_iers_last_sync"
            android:summary="@string/preference_iers_last_sync_default"
            android:selectable="false" />

        <ListPreference
            android:key="preference_iers_auto_sync_hours"
            android:title="@string/preference_iers_auto_sync_hours"
            android:summary="%s"
            android:entries="@array/preference_iers_auto_sync_hours_entries"
            android:entryValues="@array/preference_iers_auto_sync_hours_values"
            android:defaultValue="168" />

    </PreferenceCategory>

</PreferenceScreen>
