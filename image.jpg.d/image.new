␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀	␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Q0␀␀␀␀␀␀
MVU␀␀␀␀SSZG␀␀S[L␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀␀␀␀␀!␀␀␀␀"␀␀␀␀␀␀␀
	␀␀␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀&;B␀@YZ#␀␀␀␀␀␀␀␀␀␀␀␀')$␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀&␀␀␀␀',)␀**␀␀␀␀␀␀	␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀
␀␀␀␀␀␀␀␀␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀
␀␀		␀␀␀␀␀␀␀	
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
␀	␀␀␀␀␀␀␀␀␀␀␀␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
␀␀␀␀␀␀␀␀	␀␀	␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀	␀␀␀
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀
␀␀	␀␀␀␀␀␀␀

␀␀␀␀␀␀␀␀␀␀␀	␀␀␀␀␀␀␀␀␀␀␀␀	␀␀	␀␀␀␀␀␀	␀␀␀␀␀␀␀␀	␀␀␀␀	␀␀␀␀␀␀␀␀␀␀